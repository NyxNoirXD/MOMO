# ---- Bot (webhook receiver + download-link logic) ----
# Public URL of the bot (Render: https://<service>.onrender.com). Enables webhook auto-registration.
OPENWA_PUBLIC_URL=
# Shared secret for webhook HMAC verification (generate: openssl rand -hex 32)
WEBHOOK_SECRET=
# OpenWA API key. Leave empty when co-located with OpenWA (auto-reads /app/data/.api-key)
OPENWA_API_KEY=
# Session name in OpenWA (must match what you create in the dashboard)
OPENWA_SESSION_NAME=momo
# Bot HTTP port (internal; only used by the router)
BOT_PORT=3001
# Conversation state TTL (ms) before a search flow resets
BOT_STATE_TTL_MS=600000
# Prefixes that trigger the bot in groups (any of these chars). Default: / or !
# In DMs prefixes are optional; in groups bare messages are ignored.
GROUP_COMMAND_PREFIXES=/!
# AniList search cache TTL (ms)
SEARCH_CACHE_TTL_MS=300000
# Upstream endpoints (override only for testing)
# ANILIST_ENDPOINT=https://graphql.anilist.co
# NEKO_BASE_URL=https://mapper.nekostream.site/api/mal

# ---- OpenWA ----
ENGINE_TYPE=baileys
AUTO_START_SESSIONS=true
LOG_LEVEL=info
# Keep heap under free-tier RAM; harmless elsewhere
# OPENWA_NODE_OPTIONS=--max-old-space-size=256

# ---- Session persistence (recommended: Backblaze B2, 10 GB free) ----
# Remote spec: "b2:momo-backup" or "r2:momo-backup" (Cloudflare R2). Empty = backups disabled.
BACKUP_REMOTE=
# rclone config via env (Backblaze B2):
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
# Backup cadence
BACKUP_INTERVAL_SECONDS=900
BACKUP_RETENTION_DAYS=3